# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://claimcheck:claimcheck@localhost:5432/claimcheck
# Optional: database used by the test suite (tables are truncated by tests)
TEST_DATABASE_URL=postgresql://claimcheck:claimcheck@localhost:5432/claimcheck_test
# Optional overrides (defaults shown). Keep identical across v1/v2 runs.
# CLAIMCHECK_MODEL=claude-sonnet-5-5
# CLAIMCHECK_API_BASE=https://api.anthropic.com
# CLAIMCHECK_TIMEOUT_S=180
# CLAIMCHECK_MAX_TURNS=3
# CLAIMCHECK_MAX_TOKENS=16000
